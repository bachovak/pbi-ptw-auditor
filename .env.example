# Power BI Publish-to-Web Auditor — environment variables
# Copy this file to .env and fill in your values. Never commit .env to source control.

# Required for all auth methods
# Your Entra (Azure AD) tenant ID (GUID)
PBI_TENANT_ID=00000000-0000-0000-0000-000000000000

# Entra app registration client ID (GUID)
PBI_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Required only for --auth service-principal (default)
# Client secret for the app registration above
PBI_CLIENT_SECRET=your-client-secret-here
